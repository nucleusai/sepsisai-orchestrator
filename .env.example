# =============================================================================
# SepsisAI-Orchestrator - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env

# --- MongoDB -----------------------------------------------------------------
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=SepsisTraining

# --- AI Prediction Service ---------------------------------------------------
AI_SERVICE_HOST=ai-prediction
AI_SERVICE_PORT=8000

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_PORT=8501

# --- CDA Preprocessing -------------------------------------------------------
INPUT_DATA_DIR=/input_data
OUTPUT_DATA_DIR=/output_data
